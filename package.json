{
  "name": "steam-led-controller",
  "version": "0.0.2-Alpha-2",
  "description": "Control the LED bar on your Steam Machine",
  "main": "main.js",
  "author": "Igor Castilheiro",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --linux "
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.igorcastilheiro.steam-led-controller",
    "productName": "Steam LED Controller",
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    },
    "files": [
      "main.js",
      "preload.js",
      "led-backend.js",
      "index.html",
      "renderer.js",
      "styles.css"
    ]
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
